<?php

declare(strict_types=1);

// Check if the application is in maintenance mode...
if (!file_exists($down = __DIR__ . '/maintenance.json')) {
    return;
}

// Decode the "down" file's JSON, one caught mid-write still answers 503...
$data = json_decode((string)file_get_contents($down), true) ?: [];

// Redirect to the proper path if necessary, compared by path, so an absolute URL on this host does not loop...
if (isset($data['redirect'])) {
    $target = parse_url($data['redirect']) ?: [];
    $host = (string)parse_url('//' . ($_SERVER['HTTP_HOST'] ?? ''), PHP_URL_HOST);
    $isOtherHost = isset($target['host']) && strcasecmp($target['host'], $host) !== 0;

    if ($isOtherHost || ($target['path'] ?? '/') !== parse_url($_SERVER['REQUEST_URI'] ?? '/', PHP_URL_PATH)) {
        http_response_code(302);
        header('Location: ' . $data['redirect']);
        exit;
    }
}

// Output the pre-rendered template...
http_response_code($data['status'] ?? 503);

if (!empty($data['retry'])) {
    header('Retry-After: ' . $data['retry']);
}

if (!empty($data['refresh'])) {
    header('Refresh: ' . $data['refresh']);
}

if (isset($data['template'])) {
    echo $data['template'];
}

exit;
