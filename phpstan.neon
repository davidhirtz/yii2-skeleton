parameters:
    dynamicConstantNames:
        - YII_DEBUG
        - YII_ENV
        - YII_ENV_DEV
        - YII_ENV_PROD
        - YII_ENV_TEST

    level: 5

    paths:
        - resources/views
        - src
        - tests
    scanFiles:
        - Yii.php

    # used by other bundles only, which a standalone run cannot see
    ignoreErrors:
        -
            identifier: trait.unused
            paths:
                - src/Models/Traits/*
            reportUnmatched: false
