parameters:
    dynamicConstantNames:
        - YII_DEBUG
        - YII_ENV
        - YII_ENV_DEV
        - YII_ENV_PROD
        - YII_ENV_TEST

    level: 6

    paths:
        - resources/views
        - src
        - tests
    scanFiles:
        - Yii.php
        # mb_trim() is native from PHP 8.4 and the polyfill declares it in a file its bootstrap only requires at runtime
        - %rootDir%/../../../vendor/symfony/polyfill-mbstring/bootstrap80.php

    stubFiles:
        - stubs/yii.stub
