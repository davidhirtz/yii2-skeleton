  .tox-fullscreen .main {
    z-index: auto;
  }
  [data-aside-collapsed]:has(.aside) .main {
    margin-inline-start: calc(var(--aside-collapsed-width) - var(--aside-width));
    transition: margin-inline-start 0.2s;
  }
  [data-aside-collapsed]:has(.aside) .aside {
    --aside-open: 0;
    --aside-rail-link-width: calc(var(--aside-collapsed-width) - 2rem);
  }
  [data-aside-collapsed]:has(.aside) .aside:hover,
  [data-aside-collapsed]:has(.aside) .aside:focus-within {
    --aside-open: 1;
