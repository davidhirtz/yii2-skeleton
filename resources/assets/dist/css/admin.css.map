}

.search-result-title {
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-result-heading {
  align-items: center;
  display: flex;
  gap: 0.5rem;
  min-width: 0;
}

.search-result-subtitle {
  align-items: center;
  display: flex;
  flex-shrink: 0;
  gap: 0.5rem;
  white-space: nowrap;
}
.search-result-subtitle::before {
