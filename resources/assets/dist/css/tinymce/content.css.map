@font-face {
  font-display: swap;
  font-family: "ATC Overlook";
  font-style: normal;
  font-weight: 400;
  src: url("../..//fonts/atcoverlook-regular-webfont.woff2") format("woff2");
}
@font-face {
  font-display: swap;
  font-family: "ATC Overlook";
  font-style: normal;
  font-weight: 700;
  src: url("../..//fonts/atcoverlook-heavy-webfont.woff2") format("woff2");
}
@font-face {
  font-display: swap;
  font-family: "Bebas Neue";
  font-style: normal;
  font-weight: normal;
  src: url("../..//fonts/bebasneue_bold-webfont.woff2") format("woff2");
}
:root {
  --body-color: #000;
  --border-color: #ccc;
  color-scheme: light;
}

:root[data-theme=dark] {
  --body-color: #EAEAEA;
  --border-color: rgb(216 216 216 / 28%);
  color-scheme: dark;
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme=light]) {
    --body-color: #EAEAEA;
    --border-color: rgb(216 216 216 / 28%);
    color-scheme: dark;
  }
}
body {
  background: transparent;
  color: var(--body-color);
  font: 0.875rem/1.57142857 "ATC Overlook", sans-serif;
  margin: 0;
  padding: 1rem;
}

h1, h2, h3, h4, h5, h6 {
  margin: 1rem 0;
  line-height: 1.2;
}

h1 {
  font-size: 2.4em;
}

h2 {
  font-size: 2em;
}

h3 {
  font-size: 1.6em;
}

h4 {
  font-size: 1.4em;
}

h5 {
  font-size: 1.2em;
}

h6 {
  font-size: 1em;
}

p {
  margin: 1rem 0;
}

table {
  border-collapse: collapse;
  min-width: 100%;
}

th,
td {
  padding: 0.4rem;
  border: 1px dotted var(--border-color);
}

hr {
  border-color: var(--border-color);
  border-style: solid;
  border-width: 1px 0 0 0;
}

blockquote {
  border-left: 2px solid var(--border-color);
  margin-left: 1.5rem;
  padding-left: 1rem;
}
blockquote .mce-content-body[dir=rtl] {
  border-right: 2px solid var(--border-color);
  margin-right: 1.5rem;
  padding-right: 1rem;
}

:first-child {
  margin-top: 0;
}

:last-child {
  margin-bottom: 0;
}
