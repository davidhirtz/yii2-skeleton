{
  "name": "davidhirtz/yii2-skeleton",
  "description": "Extended framework and admin panel based on Yii 2.0 framework",
  "license": "proprietary",
  "type": "yii2-extension",
  "homepage": "https://www.github.com/davidhirtz/yii2-skeleton",
  "authors": [
    {
      "name": "David Hirtz",
      "homepage": "https://www.davidhirtz.com/"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-simplexml": "*",
    "ext-xmlwriter": "*",
    "davidhirtz/yii2-datetime-behavior": "^1.1",
    "guzzlehttp/guzzle": "^7.9",
    "jfcherng/php-diff": "^6.9",
    "mikehaertl/php-shellcommand": "^1.7",
    "robthree/twofactorauth": "^3.0",
    "sentry/sentry": "^4.15",
    "seld/cli-prompt": "^1.0",
    "symfony/mailer": "^7.4 || ^8.0",
    "symfony/polyfill-mbstring": "^1.31",
    "yiisoft/yii2": "^2.0"
  },
  "require-dev": {
    "components/jquery": "^3.7",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.5",
    "symfony/browser-kit": "^7.4",
    "symfony/css-selector": "^7.4",
    "symfony/http-client": "^7.4 || ^8.0",
    "symfony/resend-mailer": "^7.4 || ^8.0",
    "yiisoft/yii2-debug": "^2.1"
  },
  "suggest": {
    "components/jquery": "The Yii debugger's panels register their grid filters as jQuery, which the skeleton does not ship"
  },
  "provide": {
    "bower-asset/bootstrap": "*",
    "bower-asset/inputmask": "*",
    "bower-asset/jquery": "*",
    "bower-asset/punycode": "*",
    "bower-asset/yii2-pjax": "*"
  },
  "autoload": {
    "psr-4": {
      "Hirtz\\Skeleton\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Hirtz\\Skeleton\\Tests\\": "tests"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "3.x-dev"
    }
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    }
  },
  "scripts": {
    "phpstan": "phpstan --memory-limit=2G",
    "test": "phpunit"
  }
}
